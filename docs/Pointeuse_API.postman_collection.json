{
  "info": {
    "name": "Pointeuse – API ERP v1",
    "description": "API en lecture seule pour les ERP. Renseignez la variable apiKey (onglet Variables de la collection) avec une clé créée dans Réglages › API pour les ERP. Ne partagez pas la collection avec la clé dedans.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{apiKey}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://phckoqgkdmruyfifkeat.supabase.co/functions/v1/api/v1" },
    { "key": "apiKey", "value": "" },
    { "key": "from", "value": "2026-11-01" },
    { "key": "to", "value": "2026-11-30" }
  ],
  "item": [
    {
      "name": "Entreprise (tester la clé)",
      "request": { "method": "GET", "url": "{{baseUrl}}/company" }
    },
    {
      "name": "Employés",
      "request": { "method": "GET", "url": "{{baseUrl}}/employees" }
    },
    {
      "name": "Feuilles de temps",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/timesheets?from={{from}}&to={{to}}",
          "host": ["{{baseUrl}}"],
          "path": ["timesheets"],
          "query": [
            { "key": "from", "value": "{{from}}" },
            { "key": "to", "value": "{{to}}" }
          ]
        }
      }
    },
    {
      "name": "Pointages (page suivante automatique)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Réponse 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('cursor', body.next_cursor || '');",
              "console.log(body.data ? body.data.length + ' pointages, curseur suivant : ' + (body.next_cursor || 'aucun') : body);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/punches?from={{from}}&to={{to}}&limit=100",
          "host": ["{{baseUrl}}"],
          "path": ["punches"],
          "query": [
            { "key": "from", "value": "{{from}}" },
            { "key": "to", "value": "{{to}}" },
            { "key": "limit", "value": "100" }
          ]
        }
      }
    },
    {
      "name": "Pointages – page suivante",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/punches?from={{from}}&to={{to}}&limit=100&cursor={{cursor}}",
          "host": ["{{baseUrl}}"],
          "path": ["punches"],
          "query": [
            { "key": "from", "value": "{{from}}" },
            { "key": "to", "value": "{{to}}" },
            { "key": "limit", "value": "100" },
            { "key": "cursor", "value": "{{cursor}}" }
          ]
        }
      }
    }
  ]
}
