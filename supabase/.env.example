# Secrets des fonctions serveur : supabase secrets set --env-file supabase/.env
# (SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement par Supabase)

# Réputation IP (VPN, proxy, Tor) : https://ipapi.is — sans clé, offre gratuite limitée
IPAPI_KEY=

# Google Play Integrity : contenu JSON du compte de service, sur une seule ligne
GOOGLE_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE_NAME=com.pointeuse.pointeuse

# Identifiant envoyé à OpenStreetMap pour la recherche d'adresse (mettez votre e-mail ou domaine)
GEOCODER_USER_AGENT=pointeuse-missions/1.0 (contact@votre-entreprise.tn)
